generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model Cabin {
  id           Int       @id @default(autoincrement())
  createdAt    DateTime  @default(now())
  name         String
  maxCapacity  Int
  regularPrice Int
  discount     Int
  description  String
  image        String
  bookings     Booking[]
}

model Guest {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  fullName    String
  email       String    @unique
  nationalID  String
  nationality String
  countryFlag String
  bookings    Booking[]
}

model Booking {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  startDate    DateTime
  endDate      DateTime
  numNights    Int
  numGuests    Int
  cabinPrice   Int
  extrasPrice  Int
  totalPrice   Int
  status       String
  hasBreakfast Boolean
  isPaid       Boolean
  observations String
  cabinId      Int
  guestId      Int
  cabin        Cabin    @relation(fields: [cabinId], references: [id])
  guest        Guest    @relation(fields: [guestId], references: [id])
}

model Setting {
  id                  Int @id @default(1)
  minBookingLength    Int
  maxBookingLength    Int
  maxGuestsPerBooking Int
  breakfastPrice      Int
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  avatar    String?
}
